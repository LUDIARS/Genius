{
  "service": "genius",
  "include": ["src/**/*.ts"],
  "exclude": ["**/*.test.ts", "src/contracts/**", "src/contract-runtime.ts"],
  "rules": {
    "entry-runtime": false,
    "silent-catch": false,
    "spawn-watch": false,
    "interval-guard": false,
    "listener-guard": false,
    "contract-wrap": true
  },
  "importFrom": "../contract-runtime.js"
}
